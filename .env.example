# scripts/post-to-instagram.js が読み込む環境変数。
# このファイルをコピーして .env を作り、実際の値を入れてください。
# .env は絶対にコミットしないこと（.gitignore 済み）。

# Meta for Developers で作成したアプリの、Instagramビジネスアカウント用
# 長期アクセストークン（instagram_basic, instagram_content_publish, pages_show_list など）
IG_ACCESS_TOKEN=

# 連携したInstagramビジネスアカウントのID（数字のみ）
IG_BUSINESS_ACCOUNT_ID=

# 画像を公開URLとして読み込むためのGitHub raw URLのベース
# 例: https://raw.githubusercontent.com/your-name/jinja-instagram/main
GITHUB_RAW_BASE=
